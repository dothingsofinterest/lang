    "paragraphs": [
        {
            "key": "0",
            "scene": "",
            "roles": [
                "Rose-罗丝"
            ],
            "sentences": [
                {
                    "key": "0-0",
                    "startTime": "00:00:19,050",
                    "endTime": "00:00:21,050",
                    "texts": [
                        "I changed my mind.\n我改变主意了。"
                    ]
                }
            ]
        },
        {
            "key": "1",
            "scene": "",
            "roles": [
                "Rose-罗丝"
            ],
            "sentences": [
                {
                    "key": "1-0",
                    "startTime": "00:00:27,050",
                    "endTime": "00:00:29,000",
                    "texts": [
                        "They said you might be up here.\n他们说你可能在这上面。"
                    ]
                }
            ]
        },
        {
            "key": "2",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "2-0",
                    "startTime": "00:00:30,200",
                    "endTime": "00:00:33,000",
                    "texts": [
                        "Give me your hand.\n把手给我。"
                    ]
                }
            ]
        },
        {
            "key": "3",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "3-0",
                    "startTime": "00:00:39,200",
                    "endTime": "00:00:42,200",
                    "texts": [
                        "Now close your eyes.\n现在闭上你的眼睛。"
                    ]
                }
            ]
        },
        {
            "key": "4",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "4-0",
                    "startTime": "00:00:42,200",
                    "endTime": "00:00:44,000",
                    "texts": [
                        "Go on.\n闭上眼睛。"
                    ]
                }
            ]
        },
        {
            "key": "5",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "5-0",
                    "startTime": "00:00:47,200",
                    "endTime": "00:00:49,200",
                    "texts": [
                        "Step up.\n迈上来。"
                    ]
                }
            ]
        },
        {
            "key": "6",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "6-0",
                    "startTime": "00:00:52,200",
                    "endTime": "00:00:54,266",
                    "texts": [
                        "Hold on to the railing.\n握住栏杆。"
                    ]
                },
                {
                    "key": "6-1",
                    "startTime": "00:00:54,679",
                    "endTime": "00:00:56,386",
                    "texts": [
                        "Keep your eyes closed. Don't peek.\n闭上眼睛。别偷看。"
                    ]
                }
            ]
        },
        {
            "key": "7",
            "scene": "",
            "roles": [
                "Rose-罗丝"
            ],
            "sentences": [
                {
                    "key": "7-0",
                    "startTime": "00:00:56,396",
                    "endTime": "00:00:57,157",
                    "texts": [
                        "I'm not.\n我不偷看。"
                    ]
                }
            ]
        },
        {
            "key": "8",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "8-0",
                    "startTime": "00:00:58,200",
                    "endTime": "00:01:01,200",
                    "texts": [
                        "Step up onto the rail.\n踩在那个栏杆上。"
                    ]
                }
            ]
        },
        {
            "key": "9",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "9-0",
                    "startTime": "00:01:04,200",
                    "endTime": "00:01:09,050",
                    "texts": [
                        "Hold on. Hold on. Keep your eyes closed.\n抓牢。抓牢。别睁眼。"
                    ]
                }
            ]
        },
        {
            "key": "10",
            "scene": "",
            "roles": [
                "Jack-杰克",
                "Rose-罗丝"
            ],
            "sentences": [
                {
                    "key": "10-0",
                    "startTime": "00:01:09,200",
                    "endTime": "00:01:13,000",
                    "texts": [
                        "Do you trust me?\n相信我吗？",
                        "I trust you.\n我相信你。"
                    ]
                }
            ]
        },
        {
            "key": "11",
            "scene": "",
            "roles": [
                "Jack-杰克"
            ],
            "sentences": [
                {
                    "key": "11-0",
                    "startTime": "00:01:21,000",
                    "endTime": "00:01:26,000",
                    "texts": [
                        "All right, open your eyes.\n好了，睁开眼睛。"
                    ]
                }
            ]
        },
        {
            "key": "12",
            "scene": "",
            "roles": [
                "Rose-罗丝"
            ],
            "sentences": [
                {
                    "key": "12-0",
                    "startTime": "00:01:32,100",
                    "endTime": "00:01:35,100",
                    "texts": [
                        "I'm flying, Jack.\n我飞起来了。杰克。"
                    ]
                }
            ]
        }
    ]
}